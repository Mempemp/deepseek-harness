; NSIS owns installer localization independently of the Electron application locale.
LangString INSTALLER_INSTALL ${LANG_ENGLISH} "Install now"
LangString INSTALLER_INSTALL ${LANG_SIMPCHINESE} "立即安装"
LangString INSTALLER_UPDATE ${LANG_ENGLISH} "Update"
LangString INSTALLER_UPDATE ${LANG_SIMPCHINESE} "更新"
LangString INSTALLER_FINISH ${LANG_ENGLISH} "Finish"
LangString INSTALLER_FINISH ${LANG_SIMPCHINESE} "完成"
LangString INSTALLER_NATIVE_PROGRESS ${LANG_ENGLISH} "Preparing installation… %d%%"
LangString INSTALLER_NATIVE_PROGRESS ${LANG_SIMPCHINESE} "正在准备安装… %d%%"
LangString INSTALLER_PROGRESS_EXTRACT ${LANG_ENGLISH} "Extracting files… %d%%"
LangString INSTALLER_PROGRESS_EXTRACT ${LANG_SIMPCHINESE} "正在解压文件… %d%%"
LangString INSTALLER_PROGRESS_COPY ${LANG_ENGLISH} "Installing files… %d%%"
LangString INSTALLER_PROGRESS_COPY ${LANG_SIMPCHINESE} "正在安装文件… %d%%"
LangString INSTALLER_PROGRESS_REGISTER ${LANG_ENGLISH} "Finishing installation… %d%%"
LangString INSTALLER_PROGRESS_REGISTER ${LANG_SIMPCHINESE} "正在完成安装… %d%%"
LangString INSTALLER_PROGRESS_CLEAN ${LANG_ENGLISH} "Cleaning temporary files… %d%%"
LangString INSTALLER_PROGRESS_CLEAN ${LANG_SIMPCHINESE} "正在清理临时文件… %d%%"
LangString INSTALLER_CHOOSE_PATH ${LANG_ENGLISH} "Choose location"
LangString INSTALLER_CHOOSE_PATH ${LANG_SIMPCHINESE} "选择安装位置"
LangString INSTALLER_BROWSE ${LANG_ENGLISH} "Browse"
LangString INSTALLER_BROWSE ${LANG_SIMPCHINESE} "选择"
LangString INSTALLER_LAUNCH ${LANG_ENGLISH} "Launch now"
LangString INSTALLER_LAUNCH ${LANG_SIMPCHINESE} "立即启动"
LangString INSTALLER_LAUNCH_FAILED ${LANG_ENGLISH} "DeepSeek Harness could not be launched. Retry, or clear Launch now and close the installer."
LangString INSTALLER_LAUNCH_FAILED ${LANG_SIMPCHINESE} "无法启动 DeepSeek Harness。请重试，或取消勾选立即启动后关闭安装程序。"
LangString INSTALLER_UI_ERROR ${LANG_ENGLISH} "The installer could not initialize its window. Close it and try again."
LangString INSTALLER_UI_ERROR ${LANG_SIMPCHINESE} "无法初始化安装窗口，请关闭后重试。"
LangString INSTALLER_THEME_ERROR ${LANG_ENGLISH} "Use /THEME=auto, /THEME=light or /THEME=dark."
LangString INSTALLER_THEME_ERROR ${LANG_SIMPCHINESE} "主题参数须为 /THEME=auto、/THEME=light 或 /THEME=dark。"
LangString INSTALLER_FAILED ${LANG_ENGLISH} "Installation did not finish. Close this installer and retry. If the problem persists, download the installer again."
LangString INSTALLER_FAILED ${LANG_SIMPCHINESE} "安装未完成，请关闭安装程序后重试。如仍然失败，请重新下载安装包。"
LangString INSTALLER_RUNNING ${LANG_ENGLISH} "DeepSeek Harness is running. Quit it from the system tray and try again."
LangString INSTALLER_RUNNING ${LANG_SIMPCHINESE} "DeepSeek Harness 正在运行，请先在系统托盘中退出应用后重试。"
LangString INSTALLER_DIRECTORY_FAILED ${LANG_ENGLISH} "The installation directory could not be replaced."
LangString INSTALLER_DIRECTORY_FAILED ${LANG_SIMPCHINESE} "无法替换安装目录。"
LangString INSTALLER_DIRECTORY_HINT ${LANG_ENGLISH} "Check access to the installation directory and close programs using its files, then run the installer again. Copy the error details if the problem persists."
LangString INSTALLER_DIRECTORY_HINT ${LANG_SIMPCHINESE} "请检查安装目录的访问权限，关闭占用其中内容的程序后重新运行安装器。如仍失败，请复制错误详情。"
LangString INSTALLER_DIRECTORY_RESTORE_HINT ${LANG_ENGLISH} "The previous installation could not be restored. Keep the backup directory shown in the error details and contact support before installing again."
LangString INSTALLER_DIRECTORY_RESTORE_HINT ${LANG_SIMPCHINESE} "未能恢复原安装目录。请保留错误详情中列出的备份目录，联系支持人员后再安装。"
LangString INSTALLER_PATH_INVALID ${LANG_ENGLISH} "Choose a full local folder path. Drive roots, system folders, links and special characters are not supported."
LangString INSTALLER_PATH_INVALID ${LANG_SIMPCHINESE} "请选择本地磁盘上的完整文件夹路径，不能使用磁盘根目录、系统目录、链接目录或包含特殊字符的路径。"
LangString INSTALLER_PATH_OWNERSHIP ${LANG_ENGLISH} "Choose an empty folder or the registered DeepSeek Harness installation folder."
LangString INSTALLER_PATH_OWNERSHIP ${LANG_SIMPCHINESE} "请选择空文件夹，或 DeepSeek Harness 原来的安装目录。"
LangString INSTALLER_PATH_WRITABLE ${LANG_ENGLISH} "This location is not writable. Choose a folder available to the current user."
LangString INSTALLER_PATH_WRITABLE ${LANG_SIMPCHINESE} "无法写入此位置。请选择当前用户可写入的文件夹；安装程序不会申请管理员权限。"
LangString INSTALLER_DISK_SPACE ${LANG_ENGLISH} "There is not enough free disk space. Choose another location."
LangString INSTALLER_DISK_SPACE ${LANG_SIMPCHINESE} "此磁盘的可用空间不足，请选择其他位置。"
LangString INSTALLER_PER_USER ${LANG_ENGLISH} "This installer supports the current user only. Uninstall the existing all-users installation first."
LangString INSTALLER_PER_USER ${LANG_SIMPCHINESE} "此安装程序仅支持当前用户。请先卸载已有的所有用户安装版本。"
LangString INSTALLER_EXTRACT_FAILED ${LANG_ENGLISH} "The application files could not be extracted."
LangString INSTALLER_EXTRACT_FAILED ${LANG_SIMPCHINESE} "无法解压应用程序文件。"
LangString INSTALLER_EXTRACT_HINT ${LANG_ENGLISH} "Security software may have blocked a file, or the disk may be full. Close this installer and try again. If it keeps failing, send us the error details below."
LangString INSTALLER_EXTRACT_HINT ${LANG_SIMPCHINESE} "可能是安全软件拦截了文件，或磁盘空间不足。请关闭安装程序后重试；如仍然失败，请将下方错误信息发送给我们。"
LangString INSTALLER_EXTRACT_COPY ${LANG_ENGLISH} "Copy error details"
LangString INSTALLER_EXTRACT_COPY ${LANG_SIMPCHINESE} "复制错误信息"
LangString INSTALLER_EXTRACT_EXPAND ${LANG_ENGLISH} "Show details"
LangString INSTALLER_EXTRACT_EXPAND ${LANG_SIMPCHINESE} "显示详情"
LangString INSTALLER_EXTRACT_COLLAPSE ${LANG_ENGLISH} "Hide details"
LangString INSTALLER_EXTRACT_COLLAPSE ${LANG_SIMPCHINESE} "隐藏详情"
LangString INSTALLER_EXTRACT_SAVED ${LANG_ENGLISH} "The full report was saved to %s"
LangString INSTALLER_EXTRACT_SAVED ${LANG_SIMPCHINESE} "完整错误报告已保存到 %s"
LangString INSTALLER_EXTRACT_UNSAVED ${LANG_ENGLISH} "The full report could not be saved. Use Copy error details to keep it."
LangString INSTALLER_EXTRACT_UNSAVED ${LANG_SIMPCHINESE} "无法保存完整错误报告，请使用“复制错误信息”保留。"
LangString INSTALLER_EXTRACT_COPIED ${LANG_ENGLISH} "Error details were copied to the clipboard."
LangString INSTALLER_EXTRACT_COPIED ${LANG_SIMPCHINESE} "错误信息已复制到剪贴板。"

; Russian copy. ${LANG_RUSSIAN} exists only once the build registers Russian in the installer
; language list; an unregistered id resolves to another language's id and would overwrite its string.
!ifdef LANG_RUSSIAN
  LangString INSTALLER_INSTALL ${LANG_RUSSIAN} "Установить сейчас"
  LangString INSTALLER_UPDATE ${LANG_RUSSIAN} "Обновить"
  LangString INSTALLER_FINISH ${LANG_RUSSIAN} "Готово"
  LangString INSTALLER_NATIVE_PROGRESS ${LANG_RUSSIAN} "Подготовка к установке… %d%%"
  LangString INSTALLER_PROGRESS_EXTRACT ${LANG_RUSSIAN} "Распаковка файлов… %d%%"
  LangString INSTALLER_PROGRESS_COPY ${LANG_RUSSIAN} "Установка файлов… %d%%"
  LangString INSTALLER_PROGRESS_REGISTER ${LANG_RUSSIAN} "Завершение установки… %d%%"
  LangString INSTALLER_PROGRESS_CLEAN ${LANG_RUSSIAN} "Очистка временных файлов… %d%%"
  LangString INSTALLER_CHOOSE_PATH ${LANG_RUSSIAN} "Выбор папки установки"
  LangString INSTALLER_BROWSE ${LANG_RUSSIAN} "Обзор…"
  LangString INSTALLER_LAUNCH ${LANG_RUSSIAN} "Запустить сейчас"
  LangString INSTALLER_LAUNCH_FAILED ${LANG_RUSSIAN} "Не удалось запустить DeepSeek Harness. Повторите попытку или снимите флажок «Запустить сейчас» и закройте установщик."
  LangString INSTALLER_UI_ERROR ${LANG_RUSSIAN} "Установщику не удалось открыть своё окно. Закройте установщик и запустите его снова."
  LangString INSTALLER_THEME_ERROR ${LANG_RUSSIAN} "Укажите /THEME=auto, /THEME=light или /THEME=dark."
  LangString INSTALLER_FAILED ${LANG_RUSSIAN} "Установка не завершена. Закройте установщик и повторите попытку. Если снова не получится, скачайте установщик заново."
  LangString INSTALLER_RUNNING ${LANG_RUSSIAN} "DeepSeek Harness уже запущен. Закройте его в области уведомлений и повторите попытку."
  LangString INSTALLER_PATH_INVALID ${LANG_RUSSIAN} "Укажите полный путь к папке на локальном диске. Корень диска, системные папки, папки-ссылки и специальные символы не поддерживаются."
  LangString INSTALLER_DIRECTORY_FAILED ${LANG_RUSSIAN} "Не удалось заменить папку установки."
  LangString INSTALLER_DIRECTORY_HINT ${LANG_RUSSIAN} "Проверьте доступ к папке установки, закройте программы, которые используют её файлы, и запустите установщик снова. Если проблема повторится, скопируйте подробности ошибки."
  LangString INSTALLER_DIRECTORY_RESTORE_HINT ${LANG_RUSSIAN} "Не удалось восстановить прежнюю папку установки. Сохраните папку резервной копии из подробностей ошибки и обратитесь в поддержку, прежде чем устанавливать снова."
  LangString INSTALLER_PATH_OWNERSHIP ${LANG_RUSSIAN} "Выберите пустую папку или папку, в которую DeepSeek Harness был установлен ранее."
  LangString INSTALLER_PATH_WRITABLE ${LANG_RUSSIAN} "В эту папку нельзя записывать файлы. Выберите папку, доступную текущему пользователю: установщик не запрашивает права администратора."
  LangString INSTALLER_DISK_SPACE ${LANG_RUSSIAN} "На диске недостаточно свободного места. Выберите другую папку."
  LangString INSTALLER_PER_USER ${LANG_RUSSIAN} "Этот установщик ставит приложение только текущему пользователю. Сначала удалите версию, установленную для всех пользователей."
  LangString INSTALLER_EXTRACT_FAILED ${LANG_RUSSIAN} "Не удалось распаковать файлы приложения."
  LangString INSTALLER_EXTRACT_HINT ${LANG_RUSSIAN} "Возможно, файл заблокировала защитная программа или на диске не хватает места. Закройте установщик и повторите попытку. Если снова не получится, отправьте нам сведения об ошибке ниже."
  LangString INSTALLER_EXTRACT_COPY ${LANG_RUSSIAN} "Скопировать сведения об ошибке"
  LangString INSTALLER_EXTRACT_EXPAND ${LANG_RUSSIAN} "Показать подробности"
  LangString INSTALLER_EXTRACT_COLLAPSE ${LANG_RUSSIAN} "Скрыть подробности"
  LangString INSTALLER_EXTRACT_SAVED ${LANG_RUSSIAN} "Полный отчёт сохранён: %s"
  LangString INSTALLER_EXTRACT_UNSAVED ${LANG_RUSSIAN} "Не удалось сохранить полный отчёт. Нажмите «Скопировать сведения об ошибке»."
  LangString INSTALLER_EXTRACT_COPIED ${LANG_RUSSIAN} "Сведения об ошибке скопированы в буфер обмена."
!endif
