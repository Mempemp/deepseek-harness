# Settings the 1C build packages with. Copy to .env.windows, which stays Git ignored:
#   cp apps/desktop/.env.windows.1c apps/desktop/.env.windows
# The 1C bundle does not take part in DeepSeek's mandatory-update service, so these origins only
# satisfy the packaging preflight and keep the auth allowlist that upstream ships.
DSH_DESKTOP_APP_ID=io.dsh.desktop
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://download.deepseek.com
DOWNLOAD_TEST_RELEASE_ID=0f1e2d3c4b5a69788796a5b4c3d2e1f0
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://download.deepseek.com
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.deepseek.com"]}'
